# Copy to .env and edit before running the production stack:
#
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# .env is gitignored. Never commit real values.

# ── required ────────────────────────────────────────────────────────────────
# Database password. Compose refuses to start without it.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Signing key for auth tokens. The built-in fallback in server.ts is a known
# value, so this must be set or anyone can forge a token.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# ── database ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=sih_database

# ── ingress ─────────────────────────────────────────────────────────────────
# Host port nginx is published on.
HTTP_PORT=8080

# Public origin, once you terminate TLS in front of nginx.
PUBLIC_ORIGIN=http://localhost:8080

# Comma-separated allowlist for cross-origin API access. Leave empty when the
# frontend is served same-origin behind nginx, which is the normal setup.
CORS_ORIGIN=

# ── frontend ────────────────────────────────────────────────────────────────
# Leave EMPTY for same-origin. nginx proxies /api to the backend, so the browser
# issues relative requests and no CORS is involved. Set an absolute URL only
# when the API lives on a different host.
NEXT_PUBLIC_API_BASE_URL=

# ── database lifecycle ──────────────────────────────────────────────────────
# 1 = run `prisma db push` on start. Safe and idempotent.
RUN_MIGRATIONS_ON_START=1

# auto (default) = seed only when the catalog table is empty.
# 1 or FORCE_SEED=1 = always reseed. THIS DELETES ALL EXISTING DATA.
SEED_ON_START=auto
FORCE_SEED=0
